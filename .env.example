# =============================================================================
# Department Academic ERP — Environment Configuration
# Copy this file to backend/.env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Frontend URL (for CORS and cookie settings) ──────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_SSL=false

# ─── Redis (for session store + rate limiting + job queue) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET
SESSION_MAX_AGE_MS=1800000
# 30 minutes idle timeout for staff/student
SESSION_IDLE_TIMEOUT_MS=1800000
# 15 minutes idle timeout for HOD
SESSION_HOD_IDLE_TIMEOUT_MS=900000

# ─── Argon2id Password Hashing ────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── MFA (TOTP) ───────────────────────────────────────────────────────────────
MFA_ISSUER=Department ERP
# Key for encrypting TOTP secrets at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ─── Password Reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_WHATSAPP_MAX=10
RATE_LIMIT_WHATSAPP_WINDOW_MS=60000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
# 10 MB max upload

# ─── PDF Generation ───────────────────────────────────────────────────────────
PDF_TEMPLATE_PATH=./src/pdf/templates/report_template.pdf
PDF_OUTPUT_DIR=./storage/reports
PDF_WATERMARK_TEXT=OFFICIAL ACADEMIC REPORT

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# NEVER expose these in the frontend
WHATSAPP_ACCESS_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# ─── Department Config ────────────────────────────────────────────────────────
DEPARTMENT_NAME=Department of Computer Science and Engineering
DEPARTMENT_SHORT=CSE
COLLEGE_NAME=Your College Name
COLLEGE_ADDRESS=Your College Address

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ─── Security ─────────────────────────────────────────────────────────────────
# Key for field-level encryption of sensitive data (parent phone numbers)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ─── Production Only ──────────────────────────────────────────────────────────
# HTTPS_CERT_PATH=/etc/letsencrypt/live/yourdomain/fullchain.pem
# HTTPS_KEY_PATH=/etc/letsencrypt/live/yourdomain/privkey.pem
